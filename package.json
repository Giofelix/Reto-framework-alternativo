{
  "name": "reto_tecnico_playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regresion": "playwright test --project=chromium --grep @regresion",
    "test:multinavegador": "playwright test --grep @multinavegador",
    "reporte": "playwright show-report",
    "allure:limpiar": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "allure:generar": "allure generate allure-results -o allure-report --clean",
    "allure:abrir": "allure open allure-report",
    "allure:reporte": "npm run allure:generar && npm run allure:abrir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-playwright": "^3.14.0"
  },
  "dependencies": {
    "allure": "^3.22.1",
    "gherkin-lite": "^1.1.0"
  }
}
